#--------------------------------------
# Copy this file to .env.local and fill in your values.
DEVMODE=true

# SSL certs
# only needed for production (DEVMODE=false)
KEYPATH=
CERTPATH=

# Vertex AI / Gemini TTS — service account credentials
# Place your service account JSON at server/key/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./key/vertex-tts-key.json
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1        # optional, defaults to us-central1
VERTEX_MODEL=gemini-2.5-flash-tts  # optional, this is already the default
TTS_BACKEND=vertex
# TTS_BACKEND=gemini

# API Keys
GOOGLEAPI_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# For local testing
REACT_APP_PORT=5001
# REACT_APP_PORT=5004
