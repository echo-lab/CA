{
  "name": "react-text-to-speech",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.11.14",
    "@nlpjs/lang-en": "^5.0.0-alpha.5",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "compromise": "^14.15.0",
    "fuse.js": "^7.1.0",
    "number-to-words": "^1.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.4.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.9.0",
    "react-scripts": "^5.0.1",
    "react-scrollable-feed": "^1.3.2",
    "tailwindcss": "^3.3.3",
    "talisman": "^1.1.4"
  },
  "proxy": "https://localhost:5001",
  "scripts": {
    "start": "cross-env HTTPS=true DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start --openssl-legacy-provider",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node ./server/server.js",
    "dev": "npm-run-all --parallel start server"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(compromise|grad-school|efrt|suffix-thumb|number-to-words|talisman|@nlpjs)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5"
  }
}
